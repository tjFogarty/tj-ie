{
  "name": "tj-personal-site",
  "private": true,
  "version": "1.0.0",
  "description": "Personal website.",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "debug": "DEBUG=* eleventy",
    "dev": "NODE_ENV=development npm-run-all clean --parallel dev:*",
    "dev:eleventy": "eleventy --serve",
    "build:eleventy": "ELEVENTY_PRODUCTION=true npx @11ty/eleventy",
    "build": "NODE_ENV=production npm-run-all clean build:*"
  },
  "license": "MIT",
  "homepage": "https://tj.ie",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-img": "^6.0.4",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "browserslist": "^4.28.1",
    "html-minifier-terser": "^7.2.0",
    "lightningcss": "^1.30.1",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "^9.2.0",
    "npm-run-all2": "^9.0.2",
    "rimraf": "6.1.3"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "@11ty/recursive-copy": {
      "minimatch": "^10.2.5"
    }
  }
}
